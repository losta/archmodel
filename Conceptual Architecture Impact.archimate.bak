    <element xsi:type="archimate:BusinessObject" name="Corporate Lease" id="id-24251e72a92b487989b47946ce8237a1"/>
    <element xsi:type="archimate:BusinessObject" name="Credit Position" id="id-9b10ac7a01044e448ed0ab06b10c07d3"/>
    <element xsi:type="archimate:BusinessObject" name="Virtual Account" id="id-1a93b572a6364652a1dc07108e5bec72"/>
    <element xsi:type="archimate:BusinessObject" name="Standing Order" id="id-48e3cc40671248a3b392ab3bd4c1b385"/>
