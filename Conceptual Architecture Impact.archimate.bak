    <element xsi:type="archimate:ValueStream" name="Maintain &amp; Report" id="id-dd4c65fc528848ae957b27309af1894e"/>
    <element xsi:type="archimate:ValueStream" name="Money Market Deal Lifecycle Monitoring &amp; Query Management" id="id-a492976b54ff4b4e81cf668bcc2097c3"/>
    <element xsi:type="archimate:ValueStream" name="Liquidity Onboarding" id="id-e5c0ef139d3447db8b6d3a59074ba820"/>
