    <element xsi:type="archimate:BusinessService" name="Systems Assurance" id="id-4651db3a413a4128b17d43a576df924f"/>
    <element xsi:type="archimate:BusinessService" name="Internal Network Operations" id="id-0f91623889544d37ae9fbc85120d551d"/>
    <element xsi:type="archimate:BusinessService" name="Employee Assignment" id="id-b8f27528d33d40ea825402e0c35c16f3">
      <documentation>Orchestrate the assignment of individuals and groups to work tasks and positions, track current and projected utilization to inform resource planning and performance assessments  https://bian.org/servicelandscape-13-0-0/object_21.html?object=29775</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Employee Certification" id="id-455f30a256944e2fb69fcc813c5ddbe8">
      <documentation>Test, confirm and certify employees for recognized and qualitative skills, qualification and experience measures (e.g. education and industry qualifications, general skills, experience based inferred skills)  https://bian.org/servicelandscape-13-0-0/object_21.html?object=33795</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Travel and Expenses" id="id-6360b356218e4473a3bd1aa9c5268a87"/>
    <element xsi:type="archimate:BusinessService" name="Workforce Training" id="id-39b64012414a4121bc7db03c4c744498">
      <documentation>Develop and execute a training syllabus covering all general and specific business skills/knowledge requirements and leveraging different training mechanisms and channels as appropriate (classroom, on-line/context based, self taught, desk-side support etc.)  https://bian.org/servicelandscape-13-0-0/object_22.html?object=35546</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Employee Benefits" id="id-9f2cf7d411c1453c80bbf6455d3a6768">
      <documentation>Administer eligibility, subscription membership and access to employee benefits such as pensions, healthcare, holiday entitlement &amp; services, personal finance advice, child care, counseling etc.  https://bian.org/servicelandscape-13-0-0/object_22.html?object=37178</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Employee Data Management" id="id-efb46dec8425425cab5fb6b315e54f3d">
      <documentation>Maintain a comprehensive record of employee related details covering status and demographic attributes along with summary qualification, performance and appraisal data etc. to support workforce and individual management and administration activities  https://bian.org/servicelandscape-13-0-0/object_22.html?object=39819</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Recruitment" id="id-fdca36f677cc4fcfbfc3ff1eedfb5941">
      <documentation>Administer candidate identification, selection, evaluation and on-boarding of new employees in coordination with internal management and external recruitment and advisory agencies as necessary (e.g. for background checks)  https://bian.org/servicelandscape-13-0-0/object_21.html?object=41934</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Employee Evaluation" id="id-742a788b8de145ef8b8a9322979c4825">
      <documentation>Periodically develop a fact based assessment of employee performance, matched to agreed staff performance goals. Combine appraisal input from managers, peers, managed employees and external customers and evaluation agents as appropriate  https://bian.org/servicelandscape-13-0-0/object_22.html?object=43921</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Employee and Contractor Contract" id="id-dde38bcb76af40c7b25153a7561fe9ae">
      <documentation>Negotiate and maintain the employment contract for full, part time and contract workforce members  https://bian.org/servicelandscape-13-0-0/object_23.html?object=45237</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Employee Payroll And Incentives" id="id-a6c48f4bdefa466c83734c183acd8d1d">
      <documentation>Administer the payment of salary, commission and incentives (includes stock/option grants) in compliance with the employment contract and discretionary awards  https://bian.org/servicelandscape-13-0-0/object_23.html?object=47199</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Employee Access" id="id-3db7cb9559c14284a9a2883a9dd897af">
      <documentation>Administer the systems and information access profile and authorities of an employee  https://bian.org/servicelandscape-13-0-0/object_23.html?object=48718</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Human Resources Direction" id="id-be7a8495aba84d9cb01bccac1aeca2d1">
      <documentation>Develop and enforce HR policies and the overall HR plan for the enterprise (in coordination with subsidiaries and divisions as necessary)  https://bian.org/servicelandscape-13-0-0/object_23.html?object=48780</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Legal Compliance" id="id-d74a09df692b4a4e884b683313158982"/>
    <element xsi:type="archimate:BusinessService" name="Approved Supplier Directory" id="id-60cf85a47fbe48e282279b4ecf074208"/>
    <element xsi:type="archimate:BusinessService" name="Security Assistance" id="id-63240c4ba61547f9b43b843a95b4ab50"/>
    <element xsi:type="archimate:BusinessService" name="Security Advisory" id="id-1641c9a6d8054b6a870dde5a6d0126f6"/>
